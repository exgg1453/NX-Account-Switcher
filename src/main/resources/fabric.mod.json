      "com.nxteam.nxaccountswitcher.NXAccountSwitcher"
    ]
  },
  "mixins": [
    "nxaccountswitcher.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.15.0",
    "minecraft": "1.12.2"
